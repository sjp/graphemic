{
  // The benchmarks live outside `src` so they are never published, and they
  // measure the built output rather than the sources — which is why this is a
  // separate project: it can only be checked after `npm run build`, and
  // `npm run typecheck` has to stay runnable on a clean checkout. Nothing here
  // is emitted.
  //
  // This lives inside `bench/` rather than at the repo root as
  // `tsconfig.bench.json` so oxlint's type-aware linting — which discovers a
  // project by walking up from each file looking for a file literally named
  // `tsconfig.json`, not by reading `tsconfig.*.json` variants — finds it
  // instead of falling back to the root config, whose `include` excludes this
  // directory.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "rootDir": "."
  },
  "include": ["."]
}
