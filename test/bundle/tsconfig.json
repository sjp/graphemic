{
  // The bundle suite sits beside `src` so it is never published, and it can only
  // be checked usefully alongside the build it bundles — same reasoning as
  // `bench/tsconfig.json`, including why this lives here rather than at the
  // repo root as `tsconfig.bundle.json`: oxlint's type-aware linting discovers
  // a project by walking up from each file looking for a file literally named
  // `tsconfig.json`, not by reading `tsconfig.*.json` variants. Nothing here is
  // emitted.
  //
  // The fixtures are plain `.mjs`: they are the input to two bundlers, one of
  // which would need a TypeScript plugin to read them, and there is nothing in a
  // three-line program for a type to say.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "rootDir": "."
  },
  "include": ["."]
}
